// UniFFI UDL — interface definition for Swift and Kotlin bindings.
// This defines what the mobile apps can access from horcrux-core.

namespace horcrux {};

// -- Enums --

enum CurveType {
    "Secp256k1",
    "Ed25519",
};

enum MessageType {
    "Hello",
    "Dkg",
    "Sign",
    "Refresh",
    "Control",
    "Ack",
};

enum ChannelType {
    "Ble",
    "WifiDirect",
    "WifiLan",
    "QrCode",
    "Relay",
};

// -- MPC Configuration --

dictionary HorcruxConfig {
    u16 threshold;
    u16 total_parties;
    u16 party_index;
    CurveType curve;
};

// -- MPC Messages --

dictionary MpcMessage {
    u16 from_party;
    u16 to_party;
    u32 round;
    string session_id;
    bytes payload;
};

// -- Keygen Result --

dictionary KeygenResult {
    bytes public_key;
    bytes shard_data;
    u16 party_index;
    u16 threshold;
    u16 total_parties;
};

// -- Signing Result --

dictionary SigningResult {
    bytes signature;
    bytes r;
    bytes s;
    u8? recovery_id;
};

// -- Shard Crypto --

dictionary EncryptedShard {
    bytes nonce;
    bytes ciphertext;
    bytes salt;
};

// -- Error types --

[Error]
enum HorcruxError {
    "InvalidConfig",
    "KeygenFailed",
    "SigningFailed",
    "EncryptionFailed",
    "DecryptionFailed",
    "StorageError",
    "ProtocolError",
    "SessionError",
};
